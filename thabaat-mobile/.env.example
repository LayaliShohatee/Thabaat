EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Use this computer's LAN IP when testing on a physical phone.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:3000
# Internal LIVE $1 CharityStack checkout. Development builds only; opt in deliberately.
EXPO_PUBLIC_ENABLE_PAYMENT_CHECK=false
# Opt-in server-created links. Requires configured backend and transport migration.
# Keep false until CharityStack environment/form configuration has been verified.
EXPO_PUBLIC_SERVER_CHECKOUT=false
