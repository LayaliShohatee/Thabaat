PORT=3000
SUPABASE_URL=https://your-project.supabase.co
# Server only. Never copy this key into the mobile app.
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional if Expo push access-token security is enabled.
EXPO_ACCESS_TOKEN=
# Keep disabled until the transport migration and provider credentials are ready.
CHARITYSTACK_ENABLED=false
CHARITYSTACK_MODE=test
CHARITYSTACK_API_KEY=
# Obtain test URL from support. Live documented base (do not use for test):
# https://0k90mc4jjj.execute-api.us-east-2.amazonaws.com/v1
CHARITYSTACK_API_BASE_URL=
CHARITYSTACK_WEBHOOK_SECRET=

# Apple Wallet SERVER-ONLY configuration. Leave blank until approved Pass Type signing material exists.
# PEM files encoded base64; never EXPO_PUBLIC, committed .env, logs, or mobile bundles.
WALLET_PASS_TYPE_IDENTIFIER=
WALLET_TEAM_IDENTIFIER=
WALLET_ORGANIZATION_NAME=
WALLET_SUPPORT_CONTACT=
WALLET_SIGNER_CERT_BASE64=
WALLET_SIGNER_KEY_BASE64=
WALLET_SIGNER_KEY_PASSPHRASE=
WALLET_WWDR_CERT_BASE64=
